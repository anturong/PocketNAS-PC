<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PocketNAS-PC</AssemblyName>
    <RootNamespace>PocketNAS.PC</RootNamespace>
    <Version>1.0.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 与手机端同一套品牌标记：深色圆角方块 + 橙色 p 环 + 白色节点 -->
    <ApplicationIcon>Assets\pocketnas.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- 窗口标题栏图标和侧栏品牌标记要当资源打进程序集，ApplicationIcon 只影响 exe 的外观 -->
  <ItemGroup>
    <Resource Include="Assets\pocketnas.ico" />
    <Resource Include="Assets\logo-mark.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketNAS.Shared\PocketNAS.Shared.csproj" />
    <ProjectReference Include="..\..\easy_webdav\src\WebDAVConfigurator\WebDAVConfigurator.csproj" />
    <ProjectReference Include="..\..\SshHelper\SshHelper.csproj" />
    <ProjectReference Include="..\PocketNAS.Ftps\PocketNAS.Ftps.csproj" />
  </ItemGroup>

  <!-- 把 WebDAV 服务发布到输出目录的 service 子目录：安装服务时从这里取 exe -->
  <Target Name="PublishWebDavService" AfterTargets="Build"
          Condition="'$(SkipWebDavService)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)..\..\easy_webdav\src\WebDAVService\**\*.cs;$(MSBuildThisFileDirectory)..\..\easy_webdav\src\WebDAVService\WebDAVService.csproj"
          Outputs="$(OutDir)service\WebDAVService.exe">
    <Message Importance="high" Text="发布 WebDAV 服务 → $(OutDir)service" />
    <PropertyGroup>
      <!-- 必须转成绝对路径：相对 PublishDir 会在子项目里解析，产物会落到 WebDAVService\bin 下 -->
      <WebDavSvcPublishDir>$([System.IO.Path]::GetFullPath('$(OutDir)service'))\</WebDavSvcPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\easy_webdav\src\WebDAVService\WebDAVService.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(WebDavSvcPublishDir)" />
  </Target>
  <!-- 把 FTPS 服务发布到输出目录的 service\ftps：安装服务时从这里取 exe -->
  <Target Name="PublishFtpsService" AfterTargets="Build"
          Condition="'$(SkipFtpsService)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)..\PocketNAS.FtpsService\**\*.cs;$(MSBuildThisFileDirectory)..\PocketNAS.Ftps\**\*.cs"
          Outputs="$(OutDir)service\ftps\FtpsService.exe">
    <Message Importance="high" Text="发布 FTPS 服务 → $(OutDir)service\ftps" />
    <PropertyGroup>
      <FtpsSvcPublishDir>$([System.IO.Path]::GetFullPath('$(OutDir)service\ftps'))\</FtpsSvcPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\PocketNAS.FtpsService\PocketNAS.FtpsService.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(FtpsSvcPublishDir)" />
  </Target>

</Project>
