<UserControl x:Class="PocketNAS.PC.Views.ModulePlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
            <TextBlock x:Name="TxtHeading" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Fg.Text}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtDesc" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{StaticResource Fg.Hint}"/>
            <Button Content="写一条测试日志" Margin="0,20,0,0" HorizontalAlignment="Center"
                    Padding="14,6" Click="BtnPing_Click"/>
        </StackPanel>
    </Border>
</UserControl>
