<UserControl x:Class="PocketNAS.PC.Views.CastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,8">

            <!-- 1 网卡（整行）：启动时自动选优先推荐项，用户可改，点「应用」才生效，不落盘 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="网卡" Style="{StaticResource CardTitle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Fg.Hint}"
                               Text="启动时自动选优先推荐的网卡（有默认网关的物理网卡），用户可改；点「应用」才生效，网卡不记住上次。"/>

                    <Grid Margin="0,12,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbNic" Grid.Column="0" VerticalContentAlignment="Center"
                                  SelectionChanged="CmbNic_SelectionChanged"/>
                        <Button x:Name="BtnApply" Grid.Column="1" Content="应用" Margin="8,0,0,0"
                                Padding="16,5" Click="BtnApply_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtCurrentNic" Text="当前：—" FontSize="11"
                               Foreground="{StaticResource Fg.Muted}"/>
                    <TextBlock x:Name="TxtPending" Text="" TextWrapping="Wrap" Margin="0,4,0,0"
                               FontSize="11" Foreground="{StaticResource Fg.Hint}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="0,10,0,0"
                               Foreground="{StaticResource Fg.Hint}"
                               Text="正在投屏时点「应用」只弹提醒、不禁用按钮。"/>
                </StackPanel>
            </Border>

            <!-- 2 接收服务（整行）：当前端口 / 冲突提示 / 检测端口按钮同卡片 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="接收服务" Style="{StaticResource CardTitle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Fg.Hint}"
                               Text="手机端「更多 → 投屏」里会出现这台 PC；设备由 SSDP 网络发现，本机地址运行时枚举，不写死任何 IP。"/>

                    <Grid Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="状态：" FontSize="12" Foreground="{StaticResource Fg.Muted}"/>
                            <TextBlock x:Name="TxtState" Text="未启动" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource Fg.Text}"/>
                        </StackPanel>
                        <Button x:Name="BtnToggle" Grid.Column="1" Content="启用接收"
                                Padding="14,5" Click="BtnToggle_Click"/>
                    </Grid>

                    <TextBlock Text="设备描述地址（手机发现时从这里取）" Margin="0,0,0,4"
                               FontSize="11" Foreground="{StaticResource Fg.Muted}"/>
                    <TextBox x:Name="TxtAddress" IsReadOnly="True" Text="—"/>

                    <TextBlock x:Name="TxtPort" Text="当前端口：—" Margin="0,10,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg.Text}"/>
                    <TextBlock x:Name="TxtPortNotice" Text="" TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="11" Foreground="{StaticResource Fg.Hint}"/>
                    <Button x:Name="BtnDetect" Content="检测空闲端口并使用" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Padding="14,5" Click="BtnDetect_Click"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="0,10,0,0"
                                   Foreground="{StaticResource Fg.Hint}"
                                   Text="端口记在 cast_config.json，被占自动顺延并写日志；防火墙请按「程序」放行，不要只放行单个端口。"/>
                </StackPanel>
            </Border>

            <!-- 3 播放器 与 4 播放与安全：两列等宽横排 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="播放器" Style="{StaticResource CardTitle}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Fg.Hint}"
                                   Text="自发现本机已装播放器，也可手动指定；点「设为默认」记住选择。"/>
                        <ComboBox x:Name="CmbPlayer" Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPlayer_SelectionChanged"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSetDefault" Grid.Column="0" Content="设为默认"
                                    HorizontalAlignment="Stretch" Padding="8,5" Click="BtnSetDefault_Click"/>
                            <Button x:Name="BtnPickPlayer" Grid.Column="1" Content="手动指定程序位置"
                                    HorizontalAlignment="Stretch" Margin="6,0,0,0"
                                    Padding="8,5" Click="BtnPickPlayer_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtDefaultPlayer" Text="当前默认：—" Margin="0,8,0,0"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Fg.Muted}"/>
                        <TextBlock x:Name="TxtPlayerNotice" Text="" TextWrapping="Wrap" Margin="0,2,0,0"
                                   FontSize="10" Foreground="{StaticResource Fg.Hint}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="播放与安全" Style="{StaticResource CardTitle}"/>
                        <CheckBox x:Name="ChkConfirm" Content="首次投送时弹确认（封闭测试默认关闭）"
                                  FontSize="12" Click="ChkConfirm_Click"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Margin="0,10,0,0"
                                   Foreground="{StaticResource Fg.Hint}"
                                   Text="优先用你指定的播放器（快进 / 进度条 / 音量 / 全屏由它提供），不可用时才回退内置窗口。只关本程序自己启动的进程；关主窗口会一并停止接收。"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5 当前投送（整行） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="当前投送" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="TxtNow" Text="暂无" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource Fg.Muted}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
