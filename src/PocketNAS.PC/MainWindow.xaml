<Window x:Class="PocketNAS.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketNAS-PC" Height="740" Width="1180"
        Icon="Assets/pocketnas.ico"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource Bg.Window}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1.62*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：模块导航 -->
        <Border Grid.Column="0" Background="{StaticResource Bg.Deep}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,14,14,12">
                    <!-- 品牌标记：与手机端同一套「拓扑环」，小写 p = Pocket，中心节点 = NAS -->
                    <Image Source="Assets/logo-mark.png" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PocketNAS-PC" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg.Text}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="模块" Margin="16,0,0,6" FontSize="10.5"
                           Foreground="{StaticResource Fg.Hint}"/>

                <ListBox Grid.Row="2" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="14,9"
                                                BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource Bg.Card}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource Bg.Card}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource Accent.Blue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,9,0"
                                        Background="{Binding Dot}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                           Foreground="{Binding TitleColor}"/>
                                <Border Grid.Column="2" BorderBrush="{StaticResource Border.Strong}"
                                        BorderThickness="1" CornerRadius="3" Padding="4,0"
                                        Visibility="{Binding TagVisibility}">
                                    <TextBlock Text="{Binding TagText}" FontSize="10"
                                               Foreground="{StaticResource Fg.Hint}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" x:Name="TxtVersion" Margin="16,10,0,14" FontSize="10.5"
                           Foreground="{StaticResource Fg.Hint}"/>
            </Grid>
        </Border>

        <!-- 中：模块内容 -->
        <Grid Grid.Column="1" Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg.Text}"/>
                    <TextBlock x:Name="TxtSubtitle" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource Fg.Hint}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusPill" CornerRadius="10" Padding="9,3"
                        BorderThickness="1" BorderBrush="{StaticResource Border.Strong}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TxtStatus" FontSize="10.5"/>
                </Border>
            </Grid>

            <ContentControl Grid.Row="1" x:Name="ModuleHost" Margin="0,12,0,0"/>
        </Grid>

        <!-- 右：全局日志 -->
        <Border Grid.Column="2" Background="{StaticResource Bg.Deep}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,12,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="操作日志" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg.Muted}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="复制" FontSize="10.5" Padding="7,2" Margin="0,0,5,0"
                                Click="CopyLog_Click"/>
                        <Button Content="清空" FontSize="10.5" Padding="7,2" Click="ClearLog_Click"/>
                    </StackPanel>
                </Grid>

                <RichTextBox Grid.Row="1" x:Name="LogConsole" Background="Transparent"
                             Foreground="{StaticResource Fg.Text}" BorderThickness="0"
                             IsReadOnly="True" IsDocumentEnabled="False"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" Margin="10,0,6,0">
                    <FlowDocument LineHeight="1.35"/>
                </RichTextBox>

                <TextBlock Grid.Row="2" x:Name="TxtLogCount" Margin="14,6,0,10" FontSize="10.5"
                           Foreground="{StaticResource Fg.Hint}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
