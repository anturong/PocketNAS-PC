<UserControl x:Class="WebDAVConfigurator.WebDavView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 基本设置 -->
        <Border Style="{StaticResource Card}" Margin="0,0,5,5">
            <StackPanel>
                <TextBlock Text="基本设置" Style="{StaticResource CardTitle}"/>

                <CheckBox x:Name="ChkHttp" Content="启用 HTTP" Checked="ToggleHttp" Unchecked="ToggleHttp"/>
                <Grid Margin="0,8,0,12" x:Name="HttpPortPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HTTP 端口" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPort" Grid.Column="1"/>
                </Grid>

                <CheckBox x:Name="ChkHttps" Content="启用 HTTPS（自签名证书）" Checked="ToggleHttps" Unchecked="ToggleHttps"/>
                <Grid Margin="0,8,0,12" x:Name="HttpsPanel" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HTTPS 端口" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtHttpsPort" Grid.Column="1"/>
                </Grid>

                <TextBlock Text="共享目录" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRootDir"/>
                    <Button Grid.Column="1" Content="浏览..." Click="BrowseFolder" Margin="5,0,0,0"/>
                </Grid>

                <TextBlock Text="连接二维码" Margin="0,2,0,5"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="QrIpSelector"/>
                    <Button Grid.Column="1" Content="生成二维码" Click="GenerateQr" Margin="5,0,0,0"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="10.5"
                           Foreground="{StaticResource Fg.Hint}"
                           Text="需启用 HTTPS 且服务运行中。扫码用 PocketNAS 添加 WebDAV，账号密码取自用户列表当前选中项。"/>
            </StackPanel>
        </Border>

        <!-- 用户管理 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="用户管理" Style="{StaticResource CardTitle}"/>

                <ListBox x:Name="LstUsers" Grid.Row="1" Background="{StaticResource Bg.Input}"
                         Foreground="{StaticResource Fg.Text}"
                         BorderBrush="{StaticResource Border.Strong}" Height="96"
                         SelectionChanged="OnUserSelect" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="用户名" Margin="0,0,0,4"/>
                <TextBox Grid.Row="3" x:Name="TxtUser" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Text="密码" Margin="0,0,0,4"/>
                <TextBox Grid.Row="5" x:Name="TxtPass" Margin="0,0,0,8"/>

                <CheckBox Grid.Row="6" x:Name="ChkReadOnly" Content="只读（不可删除/上传）"/>

                <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <Button Content="添加" Click="AddUser" Background="{StaticResource Accent.Green}"
                            Foreground="White" FontWeight="SemiBold" Width="68" Margin="0,0,5,0"/>
                    <Button Content="更新" Click="UpdateUser" Background="{StaticResource Accent.Blue}"
                            Foreground="White" FontWeight="SemiBold" Width="68" Margin="0,0,5,0"/>
                    <Button Content="删除" Click="DeleteUser" Background="{StaticResource Accent.Red}"
                            Foreground="White" FontWeight="SemiBold" Width="68"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 服务控制 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="服务控制" Style="{StaticResource CardTitle}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="访问" Margin="0,0,8,0" FontSize="12.5"/>
                    <TextBlock x:Name="LnkHttp" Foreground="{StaticResource Accent.Green}" Cursor="Hand"
                               FontSize="12.5" MouseDown="OpenLink" Margin="0,0,14,0"/>
                    <TextBlock x:Name="LnkHttps" Foreground="{StaticResource Accent.Green}" Cursor="Hand"
                               FontSize="12.5" MouseDown="OpenLink" Visibility="Collapsed"/>
                    <Button Content="保存配置" Click="SaveConfig" Margin="14,0,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="重启服务" Click="RestartService" Background="{StaticResource Accent.Blue}"
                            Foreground="White" FontWeight="SemiBold" Margin="0,0,4,0" Padding="10,7"/>
                    <Button Grid.Column="1" Content="安装服务" Click="InstallService"
                            Background="{StaticResource Accent.Green}" Foreground="{StaticResource Bg.Deep}"
                            FontWeight="SemiBold" Margin="4,0" Padding="10,7"/>
                    <Button Grid.Column="2" Content="卸载服务" Click="UninstallService"
                            Background="{StaticResource Accent.Red}" Foreground="White"
                            FontWeight="SemiBold" Margin="4,0,0,0" Padding="10,7"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
