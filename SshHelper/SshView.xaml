<UserControl x:Class="SshHelper.SshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnStart" Content="▶ 一键配置并启动" Click="BtnStart_Click"
                    Background="{StaticResource Accent.Green}" Foreground="{StaticResource Bg.Deep}"
                    FontWeight="SemiBold" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="BtnTest" Content="⟳ 仅测试连接" Click="BtnTest_Click" Padding="14,7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 卡片1：连接信息 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="连接信息" Style="{StaticResource CardTitle}"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="局域网地址"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="IpSelector" MinWidth="130"
                                          SelectionChanged="IpSelector_SelectionChanged"/>
                                <TextBlock Text="复制" Foreground="{StaticResource Fg.Muted}" Cursor="Hand"
                                           MouseDown="CopySelectedIp" FontSize="10.5" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="端口"/>
                            <TextBlock Text="22" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Accent.Blue}"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="用户名"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtUser" Foreground="{StaticResource Accent.Blue}"
                                           Cursor="Hand" MouseDown="ShowUserHelp"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource Fg.Muted}" FontSize="11"
                                           Cursor="Hand" MouseDown="ShowUserHelp"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡片2：私钥管理 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="私钥管理" Style="{StaticResource CardTitle}"/>

                        <Button Content="显示 / 隐藏私钥文本" Click="ToggleKey_Click"
                                Foreground="{StaticResource Accent.Blue}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,8"/>

                        <TextBox x:Name="TxtPrivateKey" Visibility="Collapsed" IsReadOnly="True"
                                 TextWrapping="Wrap" Height="92" FontSize="10.5"
                                 Foreground="{StaticResource Accent.Amber}" Margin="0,0,0,8"/>

                        <Button Content="复制私钥文本" Click="CopyKeyText_Click"
                                Foreground="{StaticResource Accent.Green}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,6"/>

                        <Button Content="复制私钥文件" Click="CopyKeyFile_Click"
                                Foreground="{StaticResource Accent.Amber}"
                                HorizontalContentAlignment="Center" Margin="0,0,0,6"/>

                        <Button Content="更换密钥（备份 → 生成 → 部署 → 验证）" Click="ReplaceKey_Click"
                                Foreground="{StaticResource Accent.Red}"
                                HorizontalContentAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 卡片3：扫码导入 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PocketNAS 扫码导入" Style="{StaticResource CardTitle}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <Button x:Name="BtnQr" Content="生成二维码" Click="BtnQr_Click"
                                    Foreground="{StaticResource Accent.Red}"
                                    BorderBrush="{StaticResource Accent.Red}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="8,3" MinWidth="96"/>
                        </Grid>

                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Fg.Hint}">
                            SSH 服务启动后，点右上「生成二维码」手动出码；PocketNAS → SSH → 右上角扫码，
                            直接导入私钥连接。<Bold Foreground="{StaticResource Accent.Red}">二维码里含私钥，请确保周围无人窥视！</Bold>
                        </TextBlock>

                        <TextBlock x:Name="TxtQrHint" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{StaticResource Fg.Hint}" Margin="0,8,0,0"
                                   Text="二维码未生成 —— 需先「一键配置并启动」sshd 服务"/>

                        <Button x:Name="BtnQrAgain" Content="重新显示二维码" Click="BtnQrAgain_Click"
                                Foreground="{StaticResource Accent.Red}"
                                BorderBrush="{StaticResource Accent.Red}"
                                HorizontalAlignment="Center" Margin="0,8,0,0" Padding="8,3"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
