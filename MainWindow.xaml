<Window x:Class="SshHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 密钥登录配置助手" Height="720" Width="1100"
        Background="#0d1117" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左边只放按钮和日志，原来 2:1 太空；收窄后右栏能放下更大的二维码 -->
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧面板：执行与日志 -->
        <Grid Grid.Column="0" Background="#010409">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 顶部操作栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15" Background="#161b22">
                <Button x:Name="BtnStart" Content="▶ 一键配置并启动" Click="BtnStart_Click"
                        Background="#3fb950" Foreground="#0d1117" FontWeight="Bold"
                        Padding="15,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                <Button x:Name="BtnTest" Content="⟳ 仅测试连接" Click="BtnTest_Click"
                        Background="#21262d" Foreground="#e6edf3"
                        Padding="15,8" BorderThickness="1" BorderBrush="#30363d" Cursor="Hand"/>
            </StackPanel>
            <!-- 终端日志区 -->
            <RichTextBox Grid.Row="1" x:Name="LogConsole"
                         Background="Transparent" Foreground="#e6edf3"
                         BorderThickness="0" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" Margin="10">
                <FlowDocument/>
            </RichTextBox>
        </Grid>
        <!-- 右侧面板：结果与连接（套 ScrollViewer，内容再高也不会被窗口底边裁掉） -->
        <ScrollViewer Grid.Column="1" Background="#161b22" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- 卡片1：连接信息 -->
            <Border BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="20">
                <StackPanel>
                    <TextBlock Text="📡 连接信息" Foreground="#8b949e" FontWeight="Bold" FontSize="12" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="局域网地址" Foreground="#8b949e"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="IpSelector" MinWidth="130"
                                      Foreground="#58a6ff" Background="#0d1117" BorderBrush="#30363d"
                                      BorderThickness="1" Padding="4,2"
                                      SelectionChanged="IpSelector_SelectionChanged"/>
                            <TextBlock Text=" 复制" Foreground="#8b949e" Cursor="Hand"
                                       MouseDown="CopySelectedIp" FontSize="11" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="端口" Foreground="#8b949e"/>
                        <TextBlock Text="22" HorizontalAlignment="Right" Foreground="#58a6ff"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="用户名" Foreground="#8b949e"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtUser" Foreground="#58a6ff" Cursor="Hand"
                                       MouseDown="ShowUserHelp"/>
                            <TextBlock Text=" ℹ" Foreground="#8b949e" FontSize="13" Cursor="Hand"
                                       MouseDown="ShowUserHelp"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 卡片2：私钥管理 -->
            <Border BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="20">
                <StackPanel>
                    <TextBlock Text="🔑 私钥管理" Foreground="#8b949e" FontWeight="Bold" FontSize="12" Margin="0,0,0,15"/>
                    <Button Content="👁 显示/隐藏私钥文本" Click="ToggleKey_Click"
                            Background="#21262d" Foreground="#58a6ff" Padding="10,5"
                            BorderThickness="1" BorderBrush="#30363d" Margin="0,0,0,10" Cursor="Hand"/>

                    <TextBox x:Name="TxtPrivateKey" Visibility="Collapsed"
                             Background="#0d1117" Foreground="#d29922" IsReadOnly="True"
                             TextWrapping="Wrap" Height="100" BorderBrush="#30363d"
                             FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>

                    <Button Content="📋 复制私钥文本" Click="CopyKeyText_Click"
                            Background="#21262d" Foreground="#3fb950" Padding="10,5"
                            BorderThickness="1" BorderBrush="#30363d" Margin="0,0,0,10" Cursor="Hand"/>

                    <Button Content="📋 复制私钥文件" Click="CopyKeyFile_Click"
                            Background="#21262d" Foreground="#d29922" Padding="10,5"
                            BorderThickness="1" BorderBrush="#30363d" Margin="0,0,0,10" Cursor="Hand"/>

                    <Button Content="🔄 更换密钥（备份→生成→部署→验证）" Click="ReplaceKey_Click"
                            Background="#21262d" Foreground="#ff7b72" Padding="10,5"
                            BorderThickness="1" BorderBrush="#30363d" Margin="0,10,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <!-- 卡片3：二维码（PocketNAS 扫码导入） -->
            <Border Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="📱 PocketNAS 扫码导入" Foreground="#8b949e" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnQr" Content="生成二维码" Click="BtnQr_Click"
                                Background="#21262d" Foreground="#ff7b72" Padding="10,3"
                                BorderThickness="1" BorderBrush="#ff7b72" Cursor="Hand"
                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="#8b949e" FontSize="11" Margin="0,0,0,12">
                        SSH 服务启动后，点右上「生成二维码」手动出码；PocketNAS → SSH → 右上角扫码，
                        直接导入私钥连接。<Bold Foreground="#f85149">二维码里含私钥，请确保周围无人窥视！</Bold>
                    </TextBlock>
                    <!-- 二维码只在弹窗里出现：主界面不留任何含私钥的图像 -->
                    <TextBlock x:Name="TxtQrHint" TextWrapping="Wrap" Foreground="#8b949e" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Text="二维码未生成 —— 需先「一键配置并启动」sshd 服务"/>
                    <Button x:Name="BtnQrAgain" Content="重新显示二维码" Click="BtnQrAgain_Click"
                            Background="#21262d" Foreground="#ff7b72" Padding="10,4"
                            BorderThickness="1" BorderBrush="#ff7b72" Cursor="Hand"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
